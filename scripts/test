#!/usr/bin/env bash

set -e

cd "$(dirname "$0")/.."

if [ "${HA_TEST_LATEST:-0}" = "1" ]; then
  python3 -m pip install -r requirements-test.txt
  python3 -m pip install -U homeassistant
  python3 -c "import homeassistant; print('homeassistant', homeassistant.__version__)"
else
  python3 -m pip install -r requirements-test.txt
  python3 -c "import homeassistant; print('homeassistant', homeassistant.__version__)"
fi

python3 -m pytest tests/ -v "$@"
