#!/usr/bin/env bash

set -e

cd "$(dirname "$0")/.."

if [ "${HA_TEST_LATEST:-0}" = "1" ]; then
  python3 -m pip install -r requirements-test.txt
  python3 -m pip install -U homeassistant pytest-homeassistant-custom-component
  python3 -c "from homeassistant.const import __version__; print('homeassistant', __version__)"
else
  python3 -m pip install -r requirements-test.txt
  python3 -c "from homeassistant.const import __version__; print('homeassistant', __version__)"
fi

python3 -m pip install pytest-cov

python3 -m pytest tests/ -v \
  --cov=custom_components/mawaqeet \
  --cov-report=term-missing \
  --cov-fail-under=95 \
  "$@"
